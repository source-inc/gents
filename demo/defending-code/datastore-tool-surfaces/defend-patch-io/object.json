{
  "surface_id": "defend-patch-io",
  "agent_did": "did:key:zDefendingCodeAgentPlaceholder0000000000000000000000",
  "display_name": "Confirmed-finding read and patch write in a bound workspace",
  "enabled": true,
  "entries": [
    {
      "kind": "read",
      "tool_name": "read_defense_patch_assignment",
      "collection": "DefensePatchAssignment",
      "description": "Load the exact patch assignment for this bound workspace.",
      "fields": ["assignment_id", "cluster_id", "finding_id", "member_finding_ids", "contract_review_id", "contract_disposition", "skip_reason", "repository_id", "repository_path", "base_revision", "base_tree_state", "status", "expected_total"],
      "filter_fields": [
        {"name": "run_id", "required": false, "fill": "correlation"},
        {"name": "assignment_id", "required": false, "fill": {"source_field": "work_unit_id"}}
      ]
    },
    {
      "kind": "read",
      "tool_name": "read_defense_root_cause_cluster",
      "collection": "DefenseRootCauseCluster",
      "description": "Load the exact root-cause cluster assigned to this patch author.",
      "fields": ["cluster_id", "repository_path", "base_revision", "base_tree_state", "status", "primary_finding_id", "member_finding_ids", "canonical_title", "canonical_root_cause", "claim_kind", "severity", "security_boundary", "affected_paths", "remediation_scope", "expected_total"],
      "filter_fields": [
        {"name": "run_id", "required": false, "fill": "correlation"}
      ]
    },
    {
      "kind": "read",
      "tool_name": "read_defense_contract_review",
      "collection": "DefenseContractReview",
      "description": "Load the contract constraints for this cluster.",
      "fields": ["review_id", "cluster_id", "repository_path", "status", "disposition", "behavior_intentional", "spec_impact", "required_foundation_flow", "required_proof_files", "compatibility_constraints", "recommended_fix_boundary", "required_human_decision", "evidence", "expected_total"],
      "filter_fields": [
        {"name": "run_id", "required": false, "fill": "correlation"}
      ]
    },
    {
      "kind": "read",
      "tool_name": "read_defending_finding",
      "collection": "DefendingFinding",
      "description": "Load confirmed findings so the author can select the cluster's exact members.",
      "fields": ["finding_id", "source_revision", "source_tree_state", "claim_kind", "root_cause_key", "security_boundary", "attacker_identity", "attacker_controlled_input", "control_source", "entry_point", "sink", "attacker_control", "default_reachable", "required_configuration", "required_privileges", "guard_checked", "fails_closed", "violated_invariant", "impact", "contract_surface", "category", "severity", "confidence", "path", "line", "title", "description", "exploit_scenario", "recommendation", "evidence", "verification", "preconditions", "access_level", "owner_hint", "threat_ids", "verdict"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "tool_name": "write_defense_patch_candidate",
      "collection": "DefensePatchCandidate",
      "description": "Persist one patch proposal written into the bound workspace, or an explicit no-patch sentinel.",
      "output_obligation": {"scope": "trigger", "minimum_writes": 1},
      "fields": [
        {"name": "run_id", "required": false, "fill": "correlation"},
        {"name": "patch_id", "required": false, "fill": {"source_field": "work_unit_id"}},
        {"name": "workspace_id", "required": false, "fill": {"source_field": "workspace_id"}},
        {"name": "cluster_id", "required": true},
        {"name": "finding_id", "required": true},
        {"name": "member_finding_ids", "required": true},
        {"name": "contract_review_id", "required": true},
        {"name": "contract_disposition", "required": true},
        {"name": "status", "required": true},
        {"name": "repository_path", "required": true},
        {"name": "base_revision", "required": true},
        {"name": "base_tree_state", "required": true},
        {"name": "workspace_requirement", "required": true},
        {"name": "path", "required": true},
        {"name": "line", "required": true},
        {"name": "category", "required": true},
        {"name": "diff", "required": true},
        {"name": "diff_sha256", "required": true},
        {"name": "rationale", "required": true},
        {"name": "variants_checked", "required": true},
        {"name": "bypass_considered", "required": true},
        {"name": "test_note", "required": true},
        {"name": "validation_plan", "required": true},
        {"name": "expected_total", "required": true}
      ]
    }
  ]
}
