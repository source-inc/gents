    {
      "tool_name": "write_port_implementation",
      "collection": "PortImplementation",
      "description": "Close one implementation attempt with the paths and tests that landed in the bound workspace.",
      "output_obligation": {"scope": "trigger", "minimum_writes": 1},
      "fields": [
        {"name": "run_id", "required": false, "fill": "correlation"},
        {"name": "implementation_id", "required": true},
        {"name": "work_unit_id", "required": true},
        {"name": "logical_unit_id", "required": true},
        {"name": "surface_ids", "required": true},
        {"name": "attempt", "required": true},
        {"name": "workspace_id", "required": false, "fill": {"source_field": "workspace_id"}},
        {"name": "changed_paths", "required": true},
        {"name": "tests_run", "required": true},
        {"name": "summary", "required": true},
        {"name": "expected_total", "required": true}
      ]
    }
  ]
}
